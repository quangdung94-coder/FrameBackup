{
  "name": "framebackup",
  "version": "1.0.0",
  "description": "FrameBackup — 4-Column Video & Photo Backup Assistant for Windows and macOS",
  "author": "quangdung94-coder",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -b && vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "chokidar": "^6.0.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^190.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.quangdung.framebackup",
    "productName": "FrameBackup",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/7zip-bin/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "category": "public.app-category.video"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
